# Local: false. In Render: true. Production REQUIRES PostgreSQL/Neon.
PRODUCTION=false
DATABASE_URL=sqlite:///./growa_local.sqlite3
DEMO_SEED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_SECRET=
ALLOWED_HOSTS=localhost,127.0.0.1
# Google Calendar: optional, only the coordinator's authorized account
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_TOKEN_FERNET_KEY=
PUBLIC_BASE_URL=http://localhost:8000

# Opt-in pgvector (only PostgreSQL/Neon)
VECTOR_SEARCH_ENABLED=false
# Trusted HTTPS Valhalla endpoint; leave blank for honest geodesic fallback
ROUTING_BASE_URL=

# Community is usable with synthetic/ephemeral demo data in local mode.
# Public production signup REQUIRES both explicit flags and verified email flow.
COMMUNITY_SIGNUP_ENABLED=false
COMMUNITY_EMAIL_VERIFICATION_READY=false
